# 环境变量模板（复制为 .env 后填写，.env 被 gitignore 不会提交）
#
# LLM 接入（OpenAI 兼容 chat/completions，默认 DeepSeek）：
#   llm/config.py 读取顺序：进程环境变量 > 仓库根 .env（本文件复制改名）。
#   密钥绝不硬编码、不打印、不进日志。换服务只需改 base_url / 模型名。

# DeepSeek API 密钥（必填，否则 llm 调用会提示未设置）
PUBECOSPHERE_LLM_API_KEY=sk-你的key粘贴到这里

# base_url 默认 https://api.deepseek.com/v1；换其它 OpenAI 兼容服务时改这里
# PUBECOSPHERE_LLM_BASE_URL=https://api.deepseek.com/v1

# 单模型路径（python -m llm generate：提取+写稿用同一模型）
PUBECOSPHERE_LLM_MODEL=deepseek-v4-flash
# 输出上限默认顶满模型上限（393216 ≈ 384K，不人为限流）；要显式限制才取消注释
# PUBECOSPHERE_LLM_MAX_TOKENS=393216

# 网络与重试
# PUBECOSPHERE_LLM_TIMEOUT=120
# PUBECOSPHERE_LLM_MAX_RETRIES=3
# PUBECOSPHERE_LLM_BACKOFF=5
